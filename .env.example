# Anthropic API key — required for `llm_judge` evaluator and the failure analyser.
# Obtain one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Default Claude model used by the LLM-judge and failure analyser.
# Override per-call via the `model` argument if you need a different one.
AUXILAB_EVAL_MODEL=claude-haiku-4-5-20251001

# Local sentence-transformers model used by the `semantic` evaluator.
# Runs fully offline once downloaded — no API key required.
AUXILAB_EVAL_EMBED_MODEL=all-MiniLM-L6-v2

# Path to the SQLite history database (used by the report generator).
AUXILAB_EVAL_DB=.auxilab_eval/history.sqlite

# Optional: HTTP timeout (seconds) for the HttpRunner adapter.
AUXILAB_EVAL_HTTP_TIMEOUT=30
